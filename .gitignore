# ============================================================
# SmallClaw - .gitignore
# ============================================================

# --- DOCKER / ENV ---
.env

# --- SECRETS & CONFIG (NEVER COMMIT) ---
.smallclaw/config.json
.smallclaw/credentials/
.smallclaw/vault/

# --- RUNTIME DATA ---
.smallclaw/sessions/
.smallclaw/logs/
.smallclaw/memory/
.smallclaw/facts.json
.smallclaw/self_learning.json
.smallclaw/jobs.db
.smallclaw/update_state.json
.smallclaw/tasks/
.smallclaw/jobs/
.smallclaw/ocr-cache/
.smallclaw/heartbeat/
.smallclaw/task-heartbeat.json
.smallclaw/cron/runs/
.smallclaw/agents/
.smallclaw/settings.json
.smallclaw/sessions/
.smallclaw/logs/
.smallclaw/memory/
.smallclaw/facts.json
.smallclaw/self_learning.json
.smallclaw/jobs.db
.smallclaw/update_state.json
.smallclaw/tasks/
.smallclaw/jobs/
.smallclaw/ocr-cache/
.smallclaw/heartbeat/
.smallclaw/task-heartbeat.json
.smallclaw/cron/runs/
.smallclaw/cron/jobs.json
.smallclaw/skills/*
# Ship SKILL.md + templates for every flow skill ({{skill:...}} renders from
# them on other machines); keep generated skill.json/PROMPT.md/RISK.json local.
!.smallclaw/skills/*/
!.smallclaw/skills/*/SKILL.md
!.smallclaw/skills/*/templates/
!.smallclaw/skills/*/templates/**
.smallclaw/skills/*/skill.json
.smallclaw/skills/*/PROMPT.md
.smallclaw/skills/*/RISK.json
.smallclaw/skills_state.json
.smallclaw/workspace_state.json
.smallclaw/.migrated-from-localclaw
.smallclaw/agents/
.smallclaw/settings.json

# --- USER WORKSPACE (runtime output — DO NOT COMMIT) ---
# workspace/ holds the agent's runtime output and the user's own documents
# (reports, resumes, meeting notes, generated files, ...). It must stay out of
# version control to avoid leaking personal data. The gateway seeds its own
# template files (SOUL.md, USER.md, ...) at runtime, so nothing here is tracked.
# The .gitkeep keeps the directory present in a fresh clone.
workspace/*
!workspace/.gitkeep

# --- DASHBOARD RUNTIME STATE ---
ai-dashboard/dashboard-state.json
ai-dashboard/dashboard-requests.json

# --- LOGS ---
gateway.log
gateway.err.log
*.log

# --- TEMP FILES ---
tmp_payload.json
mnt/
.tmp_*
.tmp_*/
.tmp_codex_*

# --- NODE ---
node_modules/
dist/
*.js.map
package/
*.tgz

# --- PYTHON ---
__pycache__/
*.pyc

# --- TEST ARTIFACTS ---
tests/.golden-progress.log

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- LOCAL SCRATCH (backups, launcher scripts, debug dumps) ---
.backup/
backup_*/

# --- WORKBUDDY WORKSPACE DATA ---
.workbuddy/

# --- KNOWLEDGE BASE ---
# 数据目录：corpus 原始文件 + index 分块索引，均为本地产物（含用户隐私文档），不入库。
# 目录结构（.gitkeep / README.md）入库，让其他电脑 clone 后知道数据放哪、如何导入。
knowledge/corpus/*
knowledge/index/*
!knowledge/corpus/
!knowledge/index/
!knowledge/corpus/.gitkeep
!knowledge/index/.gitkeep
!knowledge/README.md
