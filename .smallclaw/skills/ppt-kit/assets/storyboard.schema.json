{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "答辩PPT storyboard（分页脚本）",
  "description": "由通用大模型产出、交给 render_pptx.py 渲染的中间协议。字段含义见 PROMPT.md 与 patterns.json。",
  "type": "object",
  "required": ["pages"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "description": "整个演示的标题（可选）" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern"],
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "enum": [
              "cover", "toc", "section", "thanks",
              "text-quote", "text-frame", "text-long", "text-2", "text-3",
              "text-4", "text-4icon", "text-6",
              "imgtext-wide", "imgtext-1v1", "imgtext-2v2", "imgtext-2pair",
              "imgtext-3", "imgtext-4", "mockup-3", "person",
              "steps-3", "process-5", "timeline-4",
              "swot", "compare-2", "two-views", "six-views",
              "table",
              "chart-pie", "chart-line", "chart-donut3", "chart-bar",
              "chart-bar-3", "chart-line-2", "chart-bar-2", "chart-bar-stacked",
              "compare-data", "cycle-4", "swot2", "timeline2-5",
              "person-2", "person-2pair", "person-3", "person-4", "person-6",
              "honors-3", "honors-6",
              "refs", "qa"
            ],
            "description": "版式 id，对应 patterns.json 与模板中的单页版式"
          },
          "fields": {
            "type": "object",
            "description": "文本槽位 key -> 文字。key 必须来自该 pattern 在 patterns.json 的 text_slots；未知 key 会被渲染器忽略并告警。允许用 \\n 分行。缺失的槽位会被清空。",
            "additionalProperties": { "type": ["string", "null"] }
          },
          "images": {
            "type": "object",
            "description": "图片槽位 key -> 图片文件路径（相对 storyboard.json 所在目录）。key 必须来自该 pattern 的 image_slots。缺失则保留模板占位符。",
            "additionalProperties": { "type": "string" }
          },
          "chart": {
            "type": ["object", "null"],
            "description": "仅当 pattern 声明 chart_slot 时有效：写入原生图表数据",
            "required": ["categories", "series"],
            "additionalProperties": false,
            "properties": {
              "categories": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "series": {
                "type": "object",
                "description": "系列名 -> 数值数组（长度必须与 categories 一致；不一致会被渲染器告警截断、质检判 FAIL）",
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "number" }
                }
              }
            }
          },
          "charts": {
            "type": "object",
            "description": "多图表页专用：图表槽位 key（见 patterns.json 的 chart_slots）-> chart 数据对象",
            "additionalProperties": { "$ref": "#/properties/pages/items/properties/chart" }
          },
          "table": {
            "type": ["object", "null"],
            "description": "仅当 pattern 声明 table_slot 时有效：写入表格数据，rows[0] 为表头",
            "required": ["rows"],
            "additionalProperties": false,
            "properties": {
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "description": "演讲者备注（答辩讲稿），写入该页备注区"
          }
        }
      }
    }
  }
}
